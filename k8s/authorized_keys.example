# KubePivot — authorized SSH public keys
#
# Copy this file to "authorized_keys" (same folder) and put YOUR public key(s)
# below, one per line. That file is git-ignored and never committed.
#
#   cp authorized_keys.example authorized_keys
#   cat ~/.ssh/id_ed25519.pub >> authorized_keys
#
# Example (replace with your own key):
# ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI................................ you@laptop
